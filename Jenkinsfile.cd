pipeline {
    agent any

    parameters {
        string(
            name: 'CI_JOB_FULL_NAME',
            defaultValue: 'react-task-tracker-ci/main',
            description: 'Full Jenkins path to the multibranch main job, for example react-task-tracker-ci/main'
        )
        string(
            name: 'CI_BUILD_NUMBER',
            defaultValue: '5',
            description: 'Successful CI build number containing the release artifact'
        )
        choice(
            name: 'ENVIRONMENT',
            choices: ['DEV', 'TEST', 'ACC', 'PROD'],
            description: 'Deployment environment'
        )
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 20, unit: 'MINUTES')
    }

    stages {
        stage('Validate deployment parameters') {
            steps {
                script {
                    def jobPath = params.CI_JOB_FULL_NAME.tokenize('/')
                    if (jobPath.isEmpty() || jobPath.last() != 'main') {
                        error('Only an artifact from the multibranch main job can be deployed.')
                    }
                    if (!(params.CI_BUILD_NUMBER ==~ /^[1-9][0-9]*$/)) {
                        error('CI_BUILD_NUMBER must be a positive Jenkins build number.')
                    }
                    def targets = [
                        DEV: [container: 'taskboard-dev', port: '8081'],
                        TEST: [container: 'taskboard-test', port: '8082'],
                        ACC: [container: 'taskboard-acc', port: '8083'],
                        PROD: [container: 'taskboard-prod', port: '8084']
                    ]
                    def target = targets[params.ENVIRONMENT]
                    if (target == null) {
                        error('ENVIRONMENT must be DEV, TEST, ACC, or PROD.')
                    }
                    env.DEPLOY_CONTAINER = target.container
                    env.DEPLOY_PORT = target.port
                    echo "Selected CI build: ${params.CI_BUILD_NUMBER}"
                    echo "Deployment environment: ${params.ENVIRONMENT}"
                    echo "Container: ${env.DEPLOY_CONTAINER}; host port: ${env.DEPLOY_PORT}"
                }
            }
        }

        stage('Retrieve selected release') {
            steps {
                copyArtifacts(
                    projectName: params.CI_JOB_FULL_NAME,
                    selector: specific(params.CI_BUILD_NUMBER),
                    filter: "release-${params.CI_BUILD_NUMBER}.tar.gz",
                    fingerprintArtifacts: true
                )
                sh "tar -xzf 'release-${params.CI_BUILD_NUMBER}.tar.gz'"
            }
        }

        stage('Build and deploy Docker image') {
            steps {
                script {
                    def imageTag = "react-task-tracker:${params.CI_BUILD_NUMBER}"
                    sh "docker build --pull --tag '${imageTag}' ."
                    sh """
                        if docker container inspect '${env.DEPLOY_CONTAINER}' >/dev/null 2>&1; then
                            docker rm --force '${env.DEPLOY_CONTAINER}'
                        fi
                    """
                    sh "docker run --detach --restart unless-stopped --name '${env.DEPLOY_CONTAINER}' --publish ${env.DEPLOY_PORT}:80 '${imageTag}'"
                    echo "Application URL: http://<docker-host>:${env.DEPLOY_PORT}/"
                }
            }
        }
    }
}
